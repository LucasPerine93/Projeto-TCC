uint8_t* animation[] = { Frame_1, Frame_2, Frame_3, Frame_4, Frame_5, Frame_6, Frame_7, Frame_8, Frame_9 };
const uint16_t numeroFrames = sizeof(animation) / sizeof(animation[0]);

void setup() {
  Bridge.begin();
  Bridge.provide("pessoaDetectada", pessoaDetectada);
  
  matrix.begin();
  matrix.textFont(Font_5x7);
  matrix.clear();
  
}

void pessoaDetectada() {
  frameAtual = 0;
  execMatrix = true;
  tempoPassado = millis();
}

void loop() {

  if (execMatrix) {

    matrix.setGrayscaleBits(3);
    if (frameAtual < numeroFrames) {
      
      if ((millis() - tempoPassado) > tempoEspera) {
        tempoPassado = millis();
        
        matrix.draw(animation[frameAtual]);
        frameAtual++;
      }
      
    } else {
      matrix.clear();
      frameAtual = 0;
      execMatrix = false;
    }
  }
}
